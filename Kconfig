config ROBA_AUTOMOUSE_KEY_CONTROL
    bool "Custom control of the PMW3610 auto mouse layer"
    default y
    depends on PMW3610 && ZMK_SPLIT_ROLE_CENTRAL
    help
        Replaces the driver's built-in auto mouse layer activation with:
        - Activating the layer only after CONFIG_ROBA_AUTOMOUSE_ACTIVATION_DELAY_MS
          of continuous trackball movement (to avoid accidental activation).
        - While active, pressing a key bound on the mouse layer restarts its
          timeout (CONFIG_PMW3610_AUTOMOUSE_TIMEOUT_MS), and pressing any
          other key exits the layer immediately.
        Note: the trackball's `automouse-layer` devicetree property must be
        left unset so the driver does not also activate the layer itself.

config ROBA_AUTOMOUSE_LAYER
    int "Layer to activate as the auto mouse layer"
    default 4
    depends on ROBA_AUTOMOUSE_KEY_CONTROL

config ROBA_AUTOMOUSE_ACTIVATION_DELAY_MS
    int "Milliseconds of continuous trackball movement required to activate the auto mouse layer"
    default 300
    depends on ROBA_AUTOMOUSE_KEY_CONTROL
